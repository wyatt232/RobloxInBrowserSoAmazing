{
  "name": "roblox-offline-player",
  "version": "0.1.0",
  "description": "Open and play Roblox games offline from .rbxl files",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "NODE_ENV=development node --loader ts-node/esm src/server/index.ts",
    "build": "tsc && esbuild src/client/index.ts --bundle --outfile=dist/public/app.js",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "roblox",
    "offline",
    "game",
    "player",
    "rbxl"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5",
    "binary-parser": "^2.1.0",
    "uuid": "^9.0.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.2",
    "typescript": "^5.1.0",
    "ts-node": "^10.9.1",
    "esbuild": "^0.18.0",
    "vite": "^4.3.0",
    "vitest": "^0.34.0",
    "eslint": "^8.44.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0"
  }
}
